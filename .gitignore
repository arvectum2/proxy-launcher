# User-specific proxy data and runtime state
proxy_core.log
proxy_core.pid
proxy_internet_backup.json
proxy_env_backup.json
proxy_settings.json

# PyInstaller output, venv, and clean-build directories
.build-venv/
build/
dist/
out/
artifact/
__pycache__/
*.spec

# Local QA artifacts
qa/

# Android generated state and fetched native dependencies
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/app/src/main/jniLibs/

# iOS generated state and fetched native dependency
mobile/ios/.build/
mobile/ios/DerivedData/
mobile/ios/Frameworks/tun2proxy.xcframework/
mobile/ios/Frameworks/.tun2proxy-version

# Server-side gateway secrets (never commit real upstream credentials)
free_gateway/.env
free_gateway/gateway.env
free_gateway/*.secrets.env
mobile/macos-appstore/.build/
mobile/macos-appstore/DerivedData/
mobile/macos-appstore/Frameworks/tun2proxy.xcframework/
mobile/macos-appstore/Frameworks/.tun2proxy-version
