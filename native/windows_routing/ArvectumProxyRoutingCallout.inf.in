[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=@DRIVER_DATE@,@DRIVER_VERSION@
CatalogFile=ArvectumProxyRoutingCallout.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[DefaultInstall.NTamd64]
CopyFiles=Driver.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService=ArvectumProxyRoutingCallout,0x00000000,Driver.Service

[Driver.CopyFiles]
ArvectumProxyRoutingCallout.sys

[Driver.Service]
DisplayName=%ServiceDisplayName%
Description=%ServiceDescription%
ServiceBinary=%13%\ArvectumProxyRoutingCallout.sys
ServiceType=1
StartType=3
ErrorControl=1

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
ArvectumProxyRoutingCallout.sys=1

[Strings]
ProviderName="Arvectum"
ServiceDisplayName="Arvectum Proxy Routing Callout"
ServiceDescription="Arvectum Proxy Launcher per-application WFP redirect callout"
DiskName="Arvectum Proxy Launcher Driver"
