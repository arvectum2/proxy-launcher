+//! Experimental scoped per-TCP flow. NEVER ship without Apple DTS approval:
+//! TN3120 explicitly discourages forwarding packet tunnel flows elsewhere.
+//! No IP-wide routes, local listener, unbound socket or credentials.
+use std::{io,net::{IpAddr,SocketAddr},time::Duration};
+use tokio::net::{TcpSocket,TcpStream};
+
+pub(crate) fn public(ip:IpAddr)->bool{
+    match ip{
+        IpAddr::V4(x)=>{
+            let [a,b,_,_]=x.octets();
+            !(x.is_private()||x.is_loopback()||x.is_link_local()||
+              x.is_multicast()||x.is_unspecified()||x.is_broadcast()||
+              a==0||(a==100&&(64..=127).contains(&b))||
+              (a==198&&matches!(b,18|19))||a>=224)
+        },
+        IpAddr::V6(x)=>!(x.is_loopback()||x.is_unspecified()||
+            x.is_multicast()||x.is_unique_local()||x.is_unicast_link_local()||
+            x.to_ipv4_mapped().is_some())
+    }
+}
+async fn resolve(host:&str,port:u16)->io::Result<Vec<SocketAddr>>{
+    let host=crate::flow_routing::validate_exact_host(host)
+        .map_err(|_|io::Error::new(io::ErrorKind::InvalidInput,"invalid direct host"))?;
+    let values=tokio::time::timeout(Duration::from_secs(4),
+         tokio::net::lookup_host((host.as_str(),port))).await
+            .map_err(|_|io::Error::new(io::ErrorKind::TimedOut,"direct DNS timeout"))??;
+    let result:Vec<_>=values.filter(|v|public(v.ip())).take(8).collect();
+    if result.is_empty(){Err(io::Error::new(io::ErrorKind::AddrNotAvailable,"no real public IP"))}
+    else{Ok(result)}
+}
+async fn scoped(peer:SocketAddr)->io::Result<TcpStream>{
+    #[cfg(target_os="ios")]
+    {
+        use std::{ffi::CString,os::fd::AsRawFd};
+        use nix::libc;
+        let mut last=io::Error::new(io::ErrorKind::AddrNotAvailable,"no physical interface");
+        for iface in ["en0","pdp_ip0","pdp_ip1","pdp_ip2"]{
+            let name=CString::new(iface).unwrap();
+            let idx=unsafe{libc::if_nametoindex(name.as_ptr())};
+            if idx==0{continue;}
+            let socket=if peer.is_ipv4(){TcpSocket::new_v4()?}else{TcpSocket::new_v6()?};
+            let (level,opt)=if peer.is_ipv4(){
+                (libc::IPPROTO_IP,libc::IP_BOUND_IF)
+            }else{(libc::IPPROTO_IPV6,libc::IPV6_BOUND_IF)};
+            let rc=unsafe{libc::setsockopt(socket.as_raw_fd(),level,opt,
+                (&idx as *const u32).cast(),std::mem::size_of::<u32>() as libc::socklen_t)};
+            if rc!=0{last=io::Error::last_os_error();continue;}
+            match tokio::time::timeout(Duration::from_secs(4),socket.connect(peer)).await{
+                Ok(Ok(t))=>return Ok(t),
+                Ok(Err(e))=>last=e,
+                Err(_)=>last=io::Error::new(io::ErrorKind::TimedOut,"scoped timeout"),
+            }
+        }
+        Err(last)
+    }
+    #[cfg(not(target_os="ios"))]
+    {
+        let sock=if peer.is_ipv4(){TcpSocket::new_v4()?}else{TcpSocket::new_v6()?};
+        tokio::time::timeout(Duration::from_secs(4),sock.connect(peer)).await
+            .map_err(|_|io::Error::new(io::ErrorKind::TimedOut,"direct timeout"))?
+    }
+}
+pub(crate) async fn connect(host:&str,port:u16)->io::Result<TcpStream>{
+    let mut err=io::Error::new(io::ErrorKind::AddrNotAvailable,"no direct target");
+    for addr in resolve(host,port).await?{
+        match scoped(addr).await{Ok(stream)=>return Ok(stream),Err(e)=>err=e}
+    }
+    Err(err)
+}
+#[cfg(test)]
+mod tests{
+    use super::*;
+    #[test] fn rejects_synthetic_and_private(){
+        for s in ["127.0.0.1","10.1.1.1","192.168.1.1","172.16.0.1",
+                  "100.64.0.1","198.18.0.1","198.19.255.254",
+                  "0.0.0.0","::1","fe80::1","fc00::1","ff02::1"]{
+            assert!(!public(s.parse().unwrap()),"{s}");
+        }
+        for s in ["1.1.1.1","8.8.8.8","2001:4860:4860::8888"]{
+            assert!(public(s.parse().unwrap()),"{s}");
+        }
+    }
+}
