 //! Exact-host intent classifier. A candidate NEVER bypasses by itself.
 //! Production iOS must not open unscoped sockets to exit its own packet tunnel;
 //! Apple TN3120 advises against local proxies or other-interface forwarding.
-use std::{collections::HashSet, net::IpAddr};
+use std::{collections::HashSet, net::IpAddr, ffi::CStr, os::raw::c_char, sync::Mutex};
+
+/// Arm only after two physically independent successful direct probes.
+/// This set is local to the tunnel, bounded, reset on each engine start.
+static RUNTIME_APPROVED: Mutex<Option<HashSet<String>>> = Mutex::new(None);
+pub(crate) fn begin_runtime() {
+    if let Ok(mut s) = RUNTIME_APPROVED.lock() { *s = Some(HashSet::new()); }
+}
+pub(crate) fn end_runtime() {
+    if let Ok(mut s) = RUNTIME_APPROVED.lock() { *s = None; }
+}
+pub(crate) fn is_armed(host: &str) -> bool {
+    RUNTIME_APPROVED.lock().ok().and_then(|s| s.as_ref().map(|x| x.contains(host)))
+        .unwrap_or(false)
+}
+/// # Safety
+/// Pointer must reference a valid NUL-terminated string.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn tun2proxy_set_direct_exact_host(host: *const c_char, enable: bool) -> i32 {
+    if host.is_null() { return -1; }
+    let Ok(v) = unsafe { CStr::from_ptr(host) }.to_str() else { return -1; };
+    let Ok(host) = validate_exact_host(v) else { return -1; };
+    let Ok(mut s) = RUNTIME_APPROVED.lock() else { return -1; };
+    let Some(approved) = s.as_mut() else { return -1; };
+    if enable && approved.len() >= 12 && !approved.contains(&host) { return -2; }
+    if enable { approved.insert(host); } else { approved.remove(&host); }
+    0
+}
