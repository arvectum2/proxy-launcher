+/// When the proxy sends FIN, a virtual client may hold its sending half
+/// open indefinitely. A join! holds the upstream socket in CLOSE_WAIT until
+/// that client also sends FIN. Bound both half-close completion directions.
+async fn bounded_half_close<C, S>(
+    client_to_server: C,
+    server_to_client: S,
+    after_server_eof: std::time::Duration,
+    after_client_eof: std::time::Duration,
+) -> (Option<tokio::io::Result<u64>>, Option<tokio::io::Result<u64>>)
+where
+    C: std::future::Future<Output = tokio::io::Result<u64>>,
+    S: std::future::Future<Output = tokio::io::Result<u64>>,
+{
+    tokio::pin!(client_to_server);
+    tokio::pin!(server_to_client);
+    tokio::select! {
+        result = &mut server_to_client => {
+            // Proxy sent FIN; dropping the other future releases its write
+            // half, avoiding indefinite CLOSE_WAIT on the proxy socket.
+            let other = tokio::time::timeout(after_server_eof, &mut client_to_server).await.ok();
+            (other, Some(result))
+        }
+        result = &mut client_to_server => {
+            // Client sent FIN: allow a final response to drain first.
+            let other = tokio::time::timeout(after_client_eof, &mut server_to_client).await.ok();
+            (Some(result), other)
+        }
+    }
+}
