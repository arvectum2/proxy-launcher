+/// After a real TLS server reset on bound Wi-Fi, retry the SAME exact-host
+/// client hello on cellular. No general UDP/raw-IP or TLS credentials involved.
+pub(crate) async fn connect_cellular_ipv6(host:&str,port:u16)->io::Result<TcpStream>{
+    #[cfg(target_os="ios")]
+    {
+        let mut last=io::Error::new(io::ErrorKind::AddrNotAvailable,
+            "no verified IPv6 cellular underlay");
+        for peer in resolve(host,port).await?.into_iter().filter(|p|p.is_ipv6()){
+            for iface in ["pdp_ip0","pdp_ip1","pdp_ip2"]{
+                match scoped_one(peer,iface).await{
+                    Ok(stream)=>return Ok(stream),
+                    Err(err)=>last=err,
+                }
+            }
+        }
+        Err(last)
+    }
+    #[cfg(not(target_os="ios"))]
+    {
+        let _=(host,port);
+        Err(io::Error::new(io::ErrorKind::Unsupported,
+            "cellular IPv6 fallback available only on iOS"))
     }
 }
