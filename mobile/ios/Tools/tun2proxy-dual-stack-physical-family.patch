+/// Read a complete bounded first TLS record without consuming application
+/// bytes irreversibly. A first TLS handshake is the ONLY protocol eligible
+/// for the iOS IPv6-specific cellular retry; HTTP/QUIC/raw IP stay proxied.
+async fn first_tls_record<R: AsyncRead + Unpin>(
+    stream: &mut R,
+) -> std::io::Result<Vec<u8>> {
+    use std::io::{Error, ErrorKind};
+    tokio::time::timeout(std::time::Duration::from_secs(4), async {
+        let mut hdr=[0u8;5];
+        stream.read_exact(&mut hdr).await?;
+        let len=u16::from_be_bytes([hdr[3],hdr[4]]) as usize;
+        if hdr[0]!=0x16 || hdr[1]!=0x03 || hdr[2]>0x04 ||
+            !(1..=16384).contains(&len) {
+            return Err(Error::new(ErrorKind::InvalidData,
+                "first packet not bounded TLS handshake"));
+        }
+        let mut packet=Vec::with_capacity(5+len);
+        packet.extend_from_slice(&hdr);
+        packet.resize(5+len,0);
+        stream.read_exact(&mut packet[5..]).await?;
+        Ok(packet)
+    }).await.map_err(|_|Error::new(ErrorKind::TimedOut,
+       "first TLS record timeout"))?
+}
+
+/// The physical TCP CONNECT alone is not enough: bound Wi-Fi IPv6 was
+/// observed on iPhone to receive a server RST immediately after ClientHello.
+/// A real server TLS first response must arrive before we commit this flow.
+async fn verify_ipv6_tls_first_record(
+    server: &mut TcpStream, hello: &[u8],
+) -> std::io::Result<Vec<u8>> {
+    use std::io::{Error,ErrorKind};
+    tokio::time::timeout(std::time::Duration::from_secs(3), async {
+        server.write_all(hello).await?;
+        let mut hdr=[0u8;5];
+        server.read_exact(&mut hdr).await?;
+        let len=u16::from_be_bytes([hdr[3],hdr[4]]) as usize;
+        if hdr[0]!=0x16 || hdr[1]!=0x03 || hdr[2]>0x04 ||
+           !(1..=16384).contains(&len) {
+            return Err(Error::new(ErrorKind::InvalidData,
+               "no verified server TLS handshake"));
+        }
+        let mut packet=Vec::with_capacity(5+len);
+        packet.extend_from_slice(&hdr);
+        packet.resize(5+len,0);
+        server.read_exact(&mut packet[5..]).await?;
+        Ok(packet)
+    }).await.map_err(|_|Error::new(ErrorKind::TimedOut,
+        "physical first TLS record timed out"))?
+}
