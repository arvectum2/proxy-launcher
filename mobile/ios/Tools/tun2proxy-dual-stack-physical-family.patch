+#[cfg(target_os="ios")]
+async fn scoped_one(peer:SocketAddr,iface:&str)->io::Result<TcpStream>{
+    use std::{ffi::CString,os::fd::AsRawFd};
+    use nix::libc;
+    let name=CString::new(iface).map_err(|_|io::Error::new(
+        io::ErrorKind::InvalidInput,"invalid interface"))?;
+    let idx=unsafe{libc::if_nametoindex(name.as_ptr())};
+    if idx==0 {return Err(io::Error::new(io::ErrorKind::AddrNotAvailable,
+        "physical interface missing"))}
+    let sock=if peer.is_ipv4(){TcpSocket::new_v4()?}else{TcpSocket::new_v6()?};
+    let (level,opt)=if peer.is_ipv4(){(libc::IPPROTO_IP,libc::IP_BOUND_IF)}
+                     else{(libc::IPPROTO_IPV6,libc::IPV6_BOUND_IF)};
+    let rc=unsafe{libc::setsockopt(sock.as_raw_fd(),level,opt,
+        (&idx as *const u32).cast(),std::mem::size_of::<u32>() as libc::socklen_t)};
+    if rc!=0{return Err(io::Error::last_os_error())}
+    tokio::time::timeout(Duration::from_secs(4),sock.connect(peer)).await
+        .map_err(|_|io::Error::new(io::ErrorKind::TimedOut,"physical scoped timeout"))?
+}
