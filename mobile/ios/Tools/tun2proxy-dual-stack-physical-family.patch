+#[cfg(test)]
+mod ios_ipv6_first_record_contract_tests {
+    use super::*;
+    #[tokio::test]
+    async fn partial_client_hello_record_is_reassembled() {
+        let (mut writer,mut reader)=tokio::io::duplex(128);
+        tokio::spawn(async move {
+            writer.write_all(&[22,3,3,0]).await.unwrap();
+            tokio::task::yield_now().await;
+            writer.write_all(&[3,1,2,3]).await.unwrap();
+        });
+        assert_eq!(first_tls_record(&mut reader).await.unwrap(),
+                   vec![22,3,3,0,3,1,2,3]);
+    }
+    #[tokio::test]
+    async fn raw_http_is_never_mistaken_for_tls() {
+        let (mut writer,mut reader)=tokio::io::duplex(64);
+        writer.write_all(b"GET / HTTP/1.1").await.unwrap();
+        assert_eq!(first_tls_record(&mut reader).await.unwrap_err().kind(),
+                   std::io::ErrorKind::InvalidData);
+    }
+    #[tokio::test]
+    async fn oversized_tls_record_fails_closed_before_payload_read() {
+        let (mut writer,mut reader)=tokio::io::duplex(64);
+        writer.write_all(&[22,3,3,0xff,0xff]).await.unwrap();
+        assert_eq!(first_tls_record(&mut reader).await.unwrap_err().kind(),
+                   std::io::ErrorKind::InvalidData);
+    }
+    #[tokio::test]
+    async fn first_server_record_rejects_tls_alert_even_after_tcp_connect() {
+        let listener=tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr=listener.local_addr().unwrap();
+        tokio::spawn(async move {
+            let (mut socket,_) = listener.accept().await.unwrap();
+            let mut hello=[0u8;8];
+            socket.read_exact(&mut hello).await.unwrap();
+            socket.write_all(&[21,3,3,0,2,2,40]).await.unwrap();
+        });
+        let mut client=TcpStream::connect(addr).await.unwrap();
+        let hello=[22,3,3,0,3,1,2,3];
+        assert_eq!(verify_ipv6_tls_first_record(&mut client,&hello).await
+                      .unwrap_err().kind(),std::io::ErrorKind::InvalidData);
+    }
+}
