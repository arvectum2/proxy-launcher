+/// Only for a lab tunnel which already observed a real proxy failure.
+  /// This NEVER makes a decision: only the host-specific, independently
+  /// verified Swift->Rust approval may unlock a live direct connection.
+  /// The upstream TCP flow is kept open for at most five more seconds.
+  pub(crate) async fn recover_after_proxy_failure(
+      host: &str, port: u16,
+  ) -> io::Result<Option<TcpStream>> {
+      let normalized = crate::flow_routing::validate_exact_host(host)
+          .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "invalid host"))?;
+      let deadline = tokio::time::Instant::now() + Duration::from_secs(5);
+      loop {
+          if crate::flow_routing::is_armed(&normalized) {
+              return connect(&normalized, port).await.map(Some);
+          }
+          if tokio::time::Instant::now() >= deadline {
+              return Ok(None);
+          }
+          tokio::time::sleep(Duration::from_millis(100)).await;
+      }
+  }
