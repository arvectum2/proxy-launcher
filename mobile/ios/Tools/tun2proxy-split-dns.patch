+// Regression checks for the exact-match split DNS used by iOS/macOS
+// NEPacketTunnel excludedRoutes.
+#[cfg(test)]
+mod split_dns_tests {
+    use super::*;
+    use hickory_proto::{op::{Message, MessageType, OpCode, Query}, rr::{Name, RecordType}};
+    use std::str::FromStr;
+
+    fn query(domain: &str, record: RecordType) -> Vec<u8> {
+        let mut msg = Message::new(42, MessageType::Query, OpCode::Query);
+        msg.add_query(Query::query(Name::from_str(domain).unwrap(), record));
+        msg.to_vec().unwrap()
+    }
+
+    #[test]
+    fn excluded_domain_returns_real_ipv4_not_synthetic() {
+        let pool = IpCidr::from_str("198.18.0.0/15").unwrap();
+        let mut dns = VirtualDns::with_bypass(
+            pool,
+            vec![("Zakupki.Gov.Ru".into(), "95.167.245.92".parse().unwrap())],
+        );
+        let (reply, _, ip) = dns.generate_query(&query("zakupki.gov.ru.", RecordType::A)).unwrap();
+        assert_eq!(ip, "95.167.245.92".parse::<IpAddr>().unwrap());
+        let answer = crate::dns::parse_data_to_dns_message(&reply, false).unwrap();
+        assert_eq!(answer.answers.len(), 1);
+        assert_eq!(crate::dns::extract_ipaddr_from_dns_message(&answer).unwrap(), ip);
+        // No IPv6 address must never trigger a synthetic DNS answer for bypass.
+        let (reply, _, _) = dns.generate_query(&query("zakupki.gov.ru.", RecordType::AAAA)).unwrap();
+        let answer = crate::dns::parse_data_to_dns_message(&reply, false).unwrap();
+        assert!(answer.answers.is_empty());
+    }
+
+    #[test]
+    fn nonexcluded_domain_keeps_virtual_dns_mapping() {
+        let pool = IpCidr::from_str("198.18.0.0/15").unwrap();
+        let mut dns = VirtualDns::with_bypass(
+            pool,
+            vec![("zakupki.gov.ru".into(), "95.167.245.92".parse().unwrap())],
+        );
+        let (_, _, ip) = dns.generate_query(&query("github.com.", RecordType::A)).unwrap();
+        assert!(matches!(ip, IpAddr::V4(ip) if ip.octets()[0] == 198 && ip.octets()[1] == 18));
+        assert_eq!(dns.resolve_ip(&ip).unwrap(), "github.com");
+    }
+
+    #[test]
+    fn excluded_ipv6_and_name_matching_are_exact() {
+        let pool = IpCidr::from_str("198.18.0.0/15").unwrap();
+        let mut dns = VirtualDns::with_bypass(pool, vec![
+            ("Example.COM.".into(), "2001:db8::2".parse().unwrap()),
+            ("example.com".into(), "203.0.113.5".parse().unwrap()),
+        ]);
+        let (_, _, v6) = dns.generate_query(&query("EXAMPLE.COM.", RecordType::AAAA)).unwrap();
+        assert_eq!(v6, "2001:db8::2".parse::<IpAddr>().unwrap());
+        let (_, _, v4) = dns.generate_query(&query("example.com", RecordType::A)).unwrap();
+        assert_eq!(v4, "203.0.113.5".parse::<IpAddr>().unwrap());
+        let (_, _, nonmatch) = dns.generate_query(&query("sub.example.com.", RecordType::A)).unwrap();
+        assert!(matches!(nonmatch, IpAddr::V4(ip) if ip.octets()[0] == 198));
+    }
+}
