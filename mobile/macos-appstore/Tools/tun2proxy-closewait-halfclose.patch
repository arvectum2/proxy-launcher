+    /// Kernel FIN arrives while both forwarding futures remain pending.
+    /// A completion-only timeout is insufficient; this test would hang with
+    /// the old bounded_half_close implementation alone.
+    #[cfg(target_os = "macos")]
+    #[tokio::test]
+    async fn tcp_close_wait_detected_while_virtual_output_is_blocked() {
+        use std::os::fd::AsRawFd;
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+            .await.expect("listener");
+        let addr = listener.local_addr().unwrap();
+        let peer = tokio::spawn(async move {
+            let (mut accepted, _) = listener.accept().await.unwrap();
+            accepted.write_all(b"buffered response").await.unwrap();
+            accepted.shutdown().await.unwrap();
+            let mut buf = [0u8; 1];
+            tokio::time::timeout(
+                std::time::Duration::from_secs(4), accepted.read(&mut buf)
+            ).await.expect("stream never released by watcher")
+        });
+
+        let stream = tokio::net::TcpStream::connect(addr).await.unwrap();
+        let fd = stream.as_raw_fd();
+        // Keep our upstream stream fully alive and unread. In the live
+        // extension this happens when a virtual client stops accepting data.
+        let blocked_writer = std::future::pending::<()>();
+        let guard = tokio::select! {
+            _ = blocked_writer => false,
+            _ = tokio::time::timeout(
+                std::time::Duration::from_secs(4),
+                wait_for_upstream_close_wait(fd)
+            ) => true,
+        };
+        assert!(guard, "CLOSE_WAIT watcher must terminate stalled forwarding");
+        drop(stream);
+        // An unread response can legitimately cause RST when the client
+        // closes; EOF and RST both prove kernel descriptor teardown.
+        match peer.await.unwrap() {
+            Ok(0) => {},
+            Err(e) if e.kind() == std::io::ErrorKind::ConnectionReset => {},
+            outcome => panic!("upstream socket not torn down: {outcome:?}"),
+        }
+    }
+
+    #[tokio::test]
+    async fn native_session_handoff_drops_stale_upstream_fd() {
+        use tokio::io::{AsyncReadExt, AsyncWriteExt};
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let mut client = tokio::net::TcpStream::connect(addr).await.unwrap();
+        let (mut peer, _) = listener.accept().await.unwrap();
+        client.write_all(b"test").await.unwrap();
+        let mut buf = [0u8; 4];
+        peer.read_exact(&mut buf).await.unwrap();
+        let mut session_tasks = tokio::task::JoinSet::<()>::new();
+        session_tasks.spawn(async move {
+            let _own_client_fd = client;
+            std::future::pending::<()>().await;
+        });
+        tokio::task::yield_now().await;
+        session_tasks.abort_all();
+        tokio::time::timeout(std::time::Duration::from_secs(2), async {
+            while session_tasks.join_next().await.is_some() {}
+        }).await.expect("session fd drain stalled");
+        let read = tokio::time::timeout(std::time::Duration::from_secs(2), peer.read(&mut buf))
+            .await.expect("server did not observe upstream TCP cleanup");
+        assert!(matches!(read, Ok(0) | Err(_)), "socket not closed after handoff");
+    }
