+/// When the proxy sends FIN, a virtual client may hold its sending half
+/// open indefinitely. A join! holds the upstream socket in CLOSE_WAIT until
+/// that client also sends FIN. Bound both half-close completion directions.
+async fn bounded_half_close<C, S>(
+    client_to_server: C,
+    server_to_client: S,
+    after_server_eof: std::time::Duration,
+    after_client_eof: std::time::Duration,
+) -> (Option<tokio::io::Result<u64>>, Option<tokio::io::Result<u64>>)
+where
+    C: std::future::Future<Output = tokio::io::Result<u64>>,
+    S: std::future::Future<Output = tokio::io::Result<u64>>,
+{
+    tokio::pin!(client_to_server);
+    tokio::pin!(server_to_client);
+    tokio::select! {
+        result = &mut server_to_client => {
+            // Proxy sent FIN; dropping the other future releases its write
+            // half, avoiding indefinite CLOSE_WAIT on the proxy socket.
+            let other = tokio::time::timeout(after_server_eof, &mut client_to_server).await.ok();
+            (other, Some(result))
+        }
+        result = &mut client_to_server => {
+            // Client sent FIN: allow a final response to drain first.
+            let other = tokio::time::timeout(after_client_eof, &mut server_to_client).await.ok();
+            (Some(result), other)
+        }
+    }
+}
+
+/// Read TCP state without consuming application bytes. The peer can send FIN
+/// while our server->virtual-client copy is blocked on backpressure, so EOF
+/// can remain unobserved indefinitely by normal Tokio copy futures.
+///
+/// Only inspect a socket while the enclosing stream is alive; never close a
+/// foreign raw descriptor or race the OS's descriptor allocator.
+#[cfg(any(target_os = "ios", target_os = "macos"))]
+fn upstream_socket_in_close_wait(fd: std::os::fd::RawFd) -> bool {
+    use nix::libc;
+    let mut info: libc::tcp_connection_info = unsafe { std::mem::zeroed() };
+    let mut len = std::mem::size_of::<libc::tcp_connection_info>() as libc::socklen_t;
+    let result = unsafe {
+        libc::getsockopt(
+            fd, libc::IPPROTO_TCP, libc::TCP_CONNECTION_INFO,
+            (&mut info as *mut libc::tcp_connection_info).cast::<libc::c_void>(),
+            &mut len,
+        )
+    };
+    result == 0 && info.tcpi_state == 5 // Darwin TCPS_CLOSE_WAIT
+}
+
+/// The native kernel state is authoritative even if our forwarder's write is
+/// stuck. Confirm CLOSE_WAIT twice before dropping the owned stream, so short
+/// receive-buffer transitions cannot provoke an unnecessary reconnect.
+#[cfg(any(target_os = "ios", target_os = "macos"))]
+async fn wait_for_upstream_close_wait(fd: std::os::fd::RawFd) {
+    let mut ticker = tokio::time::interval(std::time::Duration::from_secs(1));
+    ticker.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
+    let mut consecutive = 0_u8;
+    loop {
+        ticker.tick().await;
+        if upstream_socket_in_close_wait(fd) {
+            consecutive = consecutive.saturating_add(1);
+            if consecutive >= 2 { return; }
+        } else {
+            consecutive = 0;
+        }
+    }
+}
